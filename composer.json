{
    "name": "michaelalexeevweb/php-json-chunk",
    "description": "The fastest streaming JSON reader for PHP, and a writer to match — read and write JSON larger than memory, an item at a time: arrays, objects, NDJSON; raw, validated, indexed, in parallel. 15–21× faster than JsonMachine at 0.16 MB.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/michaelalexeevweb/php-json-chunk",
    "support": {
        "issues": "https://github.com/michaelalexeevweb/php-json-chunk/issues",
        "source": "https://github.com/michaelalexeevweb/php-json-chunk",
        "docs": "https://github.com/michaelalexeevweb/php-json-chunk/tree/master/docs"
    },
    "keywords": [
        "php",
        "json",
        "json-chunk",
        "json-chunks",
        "chunk",
        "chunked",
        "stream",
        "streaming",
        "json-streaming",
        "json-stream",
        "json-parser",
        "generator",
        "iterator",
        "memory-efficient",
        "large-json",
        "large-json-file",
        "parse-large-json",
        "json-decode",
        "fast",
        "high-performance",
        "ndjson",
        "jsonl",
        "json-lines",
        "json-writer",
        "streaming-json-writer",
        "json-index",
        "json-validator",
        "parallel",
        "pcntl"
    ],
    "require": {
        "php": ">=8.1"
    },
    "suggest": {
        "ext-pcntl": "readInParallel(), forEachInParallel() and indexValues() with workers fork processes",
        "ext-posix": "lets a parallel worker end without running the caller's destructors and shutdown functions",
        "ext-zlib": "reading and writing gzipped JSON through compress.zlib:// streams"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^2.1",
        "ergebnis/phpstan-rules": "^2.13",
        "halaxa/json-machine": "^1.2",
        "salsify/json-streaming-parser": "^8.3",
        "klkvsk/json-decode-stream": "^1.0",
        "maxakawizard/json-collection-parser": "^1.10",
        "crocodile2u/json-streamer": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "PhpJsonChunk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PhpJsonChunk\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --exclude-group performance",
        "test:performance": "phpunit --group performance",
        "benchmark": "php bin/benchmark.php",
        "compare": "php bin/benchmark.php",
        "phpstan": "phpstan analyse --configuration=phpstan.neon.dist --memory-limit=1G"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
